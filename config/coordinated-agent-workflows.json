{
  "schema_version": 1,
  "status": "shared-manifest-and-task-state-api-integrated_agent_dispatch_pending",
  "default_spend_mode": "zero_cost",
  "orchestrator_owns": [
    "user_objective",
    "constraints_and_acceptance_criteria",
    "task_graph",
    "artifact_registry",
    "permissions_and_cost_approvals",
    "run_state",
    "final_quality_gate",
    "user_report"
  ],
  "coordination": {
    "shared_job_brief_required": true,
    "shared_artifact_manifest_required": true,
    "dependency_graph_required": true,
    "task_ownership_required": true,
    "duplicate_work_check_required": true,
    "handoff_requires_artifact_ids": true,
    "agents_must_not_claim_unverified_outputs": true,
    "parallelism": "only_independent_tasks",
    "retry_policy": "bounded_classified_failures_only",
    "final_critic": {
      "required_for": [
        "multi_asset_media",
        "code_changes",
        "scientific_visualization",
        "multi_step_research"
      ],
      "must_be_independent_when_available": true,
      "must_inspect_final_artifact": true,
      "must_not_only_review_prompts_or_plans": true
    }
  },
  "roles": [
    {
      "id": "intent_engineer",
      "owns": [
        "job_brief",
        "acceptance_criteria",
        "ambiguity_flags"
      ],
      "outputs": [
        "job_brief.json"
      ],
      "may_start_after": [
        "user_request"
      ],
      "must_not": [
        "execute_tools",
        "invent_user_constraints"
      ]
    },
    {
      "id": "researcher",
      "owns": [
        "source_evidence",
        "source_freshness",
        "citations",
        "licence_metadata"
      ],
      "outputs": [
        "research_manifest.json"
      ],
      "may_start_after": [
        "job_brief.json"
      ],
      "must_not": [
        "declare_unverified_sources_true",
        "silently_reuse_unlicensed_media"
      ]
    },
    {
      "id": "asset_scout",
      "owns": [
        "candidate_assets",
        "visual_relevance_checks",
        "asset_rights"
      ],
      "outputs": [
        "asset_manifest.json"
      ],
      "may_start_after": [
        "job_brief.json"
      ],
      "must_not": [
        "search_one_exact_phrase_only",
        "treat_filename_as_visual_verification",
        "scrape_pinterest"
      ]
    },
    {
      "id": "visual_analyst",
      "owns": [
        "frame_and_asset_inspection",
        "continuity_findings",
        "visual_evidence"
      ],
      "outputs": [
        "visual_review.json"
      ],
      "may_start_after": [
        "asset_manifest.json",
        "draft_artifact"
      ],
      "must_not": [
        "judge_only_from_metadata",
        "claim_to_have_seen_unavailable_media"
      ]
    },
    {
      "id": "graphics_engineer",
      "owns": [
        "original_graphics",
        "labels",
        "arrows",
        "schematics",
        "motion_spec"
      ],
      "outputs": [
        "graphics_manifest.json",
        "graphics_assets"
      ],
      "may_start_after": [
        "job_brief.json",
        "research_manifest.json"
      ],
      "must_not": [
        "recreate_existing_owned_assets_without_reason",
        "duplicate_editor_owned_titles_or_transitions"
      ]
    },
    {
      "id": "manim_worker",
      "owns": [
        "programmatic_math_and_science_animation"
      ],
      "outputs": [
        "manim_scene_source",
        "rendered_animation",
        "render_metadata"
      ],
      "may_start_after": [
        "job_brief.json",
        "research_manifest.json"
      ],
      "status": "registered_bounded_template_renderer_runtime_install_required",
      "must_not": [
        "claim_runtime_available_without_probe",
        "replace_simple_vector_work_that_is_already_owned",
        "accept_or_execute_model_written_python"
      ]
    },
    {
      "id": "media_editor",
      "owns": [
        "timeline",
        "shot_order",
        "transitions",
        "audio_mix",
        "export_settings"
      ],
      "outputs": [
        "edit_manifest.json",
        "draft_video"
      ],
      "may_start_after": [
        "asset_manifest.json",
        "graphics_manifest.json"
      ],
      "must_not": [
        "regenerate_assets_owned_by_other_roles",
        "silently_drop_audio_or_scenes"
      ]
    },
    {
      "id": "coder",
      "owns": [
        "repository_changes",
        "integration_adapters",
        "tests"
      ],
      "outputs": [
        "patch",
        "test_report"
      ],
      "may_start_after": [
        "approved_implementation_plan"
      ],
      "must_not": [
        "edit_files_owned_by_another_active_coder_task",
        "claim_tests_passed_without_execution"
      ]
    },
    {
      "id": "critic",
      "owns": [
        "independent_error_hunt",
        "acceptance_test_results",
        "release_recommendation"
      ],
      "outputs": [
        "qa_report.json"
      ],
      "may_start_after": [
        "candidate_final_artifact"
      ],
      "must_not": [
        "approve_based_only_on_agent_claims",
        "skip_failed_acceptance_checks"
      ]
    }
  ],
  "tool_catalog": [
    {
      "id": "gemini_image_generation",
      "purpose": "Generate or edit raster images",
      "provider": "google",
      "model_configured_in_repo": "gemini-nano-banana-2.1",
      "status": "integrated_opt_in_paid",
      "secret_env": "GEMINI_API_KEY",
      "requires_per_run_cost_consent": true
    },
    {
      "id": "gemini_video_generation",
      "purpose": "Generate short video with native audio where supported",
      "provider": "google",
      "model_configured_in_repo": "gemini-omni-1.1-flash",
      "status": "integrated_opt_in_paid",
      "secret_env": "GEMINI_API_KEY",
      "requires_server_flag_and_per_run_cost_consent": true
    },
    {
      "id": "openrouter_text_models",
      "purpose": "Text model routing including configured Nemotron candidate",
      "provider": "openrouter",
      "status": "adapter_and_profile_present_live_health_unverified",
      "secret_env": "OPENROUTER_API_KEY"
    },
    {
      "id": "wikimedia_commons",
      "purpose": "Search candidate media with source and licence metadata",
      "status": "integrated",
      "cost_class": "zero_incremental_cost",
      "requires_visual_relevance_check": true
    },
    {
      "id": "pexels",
      "purpose": "Search stock photo and video",
      "status": "optional_key_gated",
      "secret_env": "PEXELS_API_KEY"
    },
    {
      "id": "pinterest",
      "purpose": "Reference discovery only",
      "status": "links_only_no_scraping_or_auto_import"
    },
    {
      "id": "manim",
      "purpose": "Programmatic mathematical and scientific animation",
      "status": "registered_structured_diagram_tool_manim_executable_required",
      "runtime_probe_required": true,
      "license_review_required": true,
      "security": "fixed_template_only; structured labels, coordinates and edge indices; 90-second timeout; 24 MB output cap",
      "output": "MP4 artifact under OMNITRIX_ARTIFACT_DIR (defaults to /tmp/omnitrix-artifacts)"
    },
    {
      "id": "ffmpeg",
      "purpose": "Media probing, transcoding, composition, and QA",
      "status": "runtime_availability_must_be_probed",
      "must_run_off_phone_for_heavy_jobs": true
    }
  ],
  "release_gate": {
    "require_artifact_exists": true,
    "require_technical_validation": true,
    "require_visual_review_of_final_export": true,
    "require_audio_review_when_audio_expected": true,
    "require_source_and_license_manifest_for_imported_media": true,
    "require_truthful_model_and_tool_status": true,
    "require_owner_approval_for_paid_or_external_side_effects": true
  },
  "runtime_components": {
    "shared_manifest_module": "core/creative_production.py",
    "manim_tool": "core/tools/implementations/manim_renderer.py",
    "registered_in_default_tool_registry": true,
    "science_diagram_ui_to_timeline_handoff": true,
    "browser_canvas_fallback": true,
    "shared_manifest_enforced_for_all_production_roles": false,
    "persistent_job_queue_and_background_worker": false,
    "independent_visual_critic": false,
    "deployed_manim_render_verified": false,
    "shared_manifest_enforced": true,
    "persisted_production_job_api": true,
    "specialist_dispatch": false,
    "note": "The shared manifest now persists scene assignments, task dependencies, exclusive artifact ownership, worker handoff revisions and unverified artifact references through authenticated plan/status/task-update routes. These routes coordinate and record work; they do not automatically invoke separate specialist models or mark final output verified."
  }
}
