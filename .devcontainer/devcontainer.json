{
  "name": "Omnitrix Studio",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.14-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Omnitrix Studio / Android API",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postStartCommand": "bash .devcontainer/start-studio.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.minimap.enabled": false,
        "editor.wordWrap": "on"
      }
    }
  }
}
